# MongoDB connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# Booking creation uses a MongoDB transaction, which requires a replica set / mongos —
# a standalone local mongod doesn't support it. Defaults: on when NODE_ENV=production, off otherwise.
# Set explicitly to "true"/"false" to override the default (e.g. if your local Mongo IS a replica set).
MONGODB_USE_TRANSACTIONS=

# JWT signing secret — use a long random string
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Gmail SMTP — use an App Password, not your account password
EMAIL_ID=your-gmail@gmail.com
EMAIL_PASS=your-16-char-app-password

# Ops address notified whenever any booking request is raised (optional)
BOOKING_NOTIFY_EMAIL=

# Optional — used by scripts/createSuperAdmin.mjs
SUPERADMIN_EMAIL=
SUPERADMIN_NAME=
SUPERADMIN_PASSWORD=
